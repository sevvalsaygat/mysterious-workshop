{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@app/components": ["./components"],
      "@app/components/*": ["./components/*"],
      "@app/containers": ["./containers"],
      "@app/containers/*": ["./containers/*"],
      "@app/lib": ["./lib"],
      "@app/lib/*": ["./lib/*"],
      "@app/constants": ["./constants"],
      "@app/constants/*": ["./constants/*"],
      "@app/data": ["./data"],
      "@app/data/*": ["./data/*"],
      "@app/actions": ["./actions"],
      "@app/actions/*": ["./actions/*"],
      "@app/types": ["./types"],
      "@app/types/*": ["./types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
